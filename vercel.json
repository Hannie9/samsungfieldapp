{
  "version": 2,
  "name": "samsungfieldapp",
  "public": true,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {},
  "buildCommand": "echo 'Static deployment'",
  "outputDirectory": "."
}
